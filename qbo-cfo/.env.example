# ---------------------------------------------------------------------------
# QuickBooks Online CFO Reporting Agent - environment configuration
# Copy to .env.local (Next.js) and fill in real values. Never commit secrets.
# ---------------------------------------------------------------------------

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/qbo_cfo

# Public base URL of this application (used to build OAuth redirect URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Intuit / QuickBooks Online -------------------------------------------
# Create an app at https://developer.intuit.com -> My Apps -> Keys & Credentials
INTUIT_CLIENT_ID=
INTUIT_CLIENT_SECRET=
# Must match EXACTLY one of the redirect URIs registered on the Intuit app
INTUIT_REDIRECT_URI=http://localhost:3000/api/quickbooks/callback
# "sandbox" or "production"
INTUIT_ENVIRONMENT=sandbox

# --- OpenAI ----------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# --- Encryption ------------------------------------------------------------
# 32-byte key, base64 or hex encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Secret used to sign application session cookies (>= 32 chars)
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# --- Scheduler -------------------------------------------------------------
# Shared secret required by POST /api/cron/monthly (Authorization: Bearer ...)
CRON_SECRET=

# --- Bootstrap owner account (used by `npm run db:migrate` on first run) ----
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=change-me-immediately

# --- Optional --------------------------------------------------------------
# Enable the synthetic multi-store demo company (no QuickBooks needed)
DEMO_MODE=true
